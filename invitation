<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Для тебя 🤍</title>

<style>

@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Montserrat:wght@300;400;500&display=swap');

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

body {
  font-family: 'Montserrat', sans-serif;
  background: #f5f2ee;
  color: #3f444b;
}

/* =========================
   СКРЫТЫЕ ПЕРЕКЛЮЧАТЕЛИ
========================= */

input[type="radio"] {
  display: none;
}

/* =========================
   КОНТЕЙНЕР
========================= */

.app {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100dvh;
  overflow: hidden;
}

/* =========================
   ЭКРАНЫ
========================= */

.screens {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.screen {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  padding: 35px 25px;

  display: flex;
  align-items: center;
  justify-content: center;

  text-align: center;

  opacity: 0;
  visibility: hidden;

  transform: translateX(35px);

  transition:
    opacity .7s ease,
    transform .7s ease,
    visibility .7s ease;
}

/* =========================
   ПЕРЕКЛЮЧЕНИЕ
========================= */

#screen1:checked ~ .screens .screen1,
#screen2:checked ~ .screens .screen2,
#screen3:checked ~ .screens .screen3,
#screen4:checked ~ .screens .screen4 {

  opacity: 1;
  visibility: visible;
  transform: translateX(0);
  z-index: 10;
}

/* =========================
   КОНТЕНТ
========================= */

.content {
  width: 100%;
  max-width: 430px;

  animation: appear .8s ease;
}

.small {
  margin-bottom: 25px;

  font-size: 11px;
  letter-spacing: 4px;

  text-transform: uppercase;

  color: #9da5ae;
}

h1 {
  margin: 0 0 28px;

  font-family: 'Cormorant Garamond', serif;

  font-size: clamp(48px, 13vw, 68px);

  line-height: .98;

  font-weight: 500;
}

p {
  font-size: 14px;
  line-height: 1.8;

  font-weight: 300;
}

.subtitle {
  margin-bottom: 32px;

  font-family: 'Cormorant Garamond', serif;

  font-size: 23px;

  line-height: 1.4;

  font-style: italic;

  color: #858c95;
}

/* =========================
   КНОПКИ
========================= */

.next {
  display: inline-block;

  margin-top: 15px;

  padding: 15px 26px;

  border-radius: 50px;

  background: rgba(255,255,255,.75);

  border: 1px solid #d8d8d5;

  box-shadow: 0 10px 30px rgba(50,50,50,.06);

  font-size: 12px;

  color: #464b52;

  cursor: pointer;

  transition: .25s ease;
}

.next:active {
  transform: scale(.94);
}

/* =========================
   ЭКРАН 1
========================= */

.screen1 {

  background:
    radial-gradient(
      circle at 50% 30%,
      #ffffff 0%,
      #f7f4f0 60%,
      #eee9e3 100%
    );
}

.screen1::before {

  content: "♡";

  position: absolute;

  top: 12%;
  left: 15%;

  font-size: 25px;

  color: #d5d9de;

  animation: float 3s infinite ease-in-out;
}

.screen1::after {

  content: "✦";

  position: absolute;

  right: 16%;
  bottom: 15%;

  color: #c8cdd3;

  animation: float 3s infinite ease-in-out;
}

/* =========================
   ЭКРАН 2
========================= */

.screen2 {

  background:
    radial-gradient(
      circle at 50% 30%,
      #ffffff 0%,
      #f3f5f4 60%,
      #e7eceb 100%
    );
}

.idea {

  margin-bottom: 25px;

  font-size: 40px;

  color: #aeb8c2;

  animation: float 3s infinite ease-in-out;
}

.screen2 p {

  margin-bottom: 18px;
}

/* =========================
   ЭКРАН 3
========================= */

.screen3 {

  background:
    linear-gradient(
      180deg,
      #edf3ee,
      #f5f3eb 55%,
      #e6e0d5
    );
}

.nature {

  margin-bottom: 18px;

  font-size: 45px;

  animation: float 3s infinite ease-in-out;
}

.screen3 h1 {

  font-size: clamp(43px, 12vw, 62px);
}

.date {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 22px;

  margin: 30px 0;

  padding: 20px 5px;

  border-top: 1px solid #d5d6d0;

  border-bottom: 1px solid #d5d6d0;
}

.date-number {

  font-family: 'Cormorant Garamond', serif;

  font-size: 60px;

  line-height: 1;
}

.date-month {

  font-size: 10px;

  letter-spacing: 2px;

  color: #777d83;
}

.line {

  width: 1px;

  height: 45px;

  background: #d0d1cb;
}

.location {

  font-size: 12px;

  line-height: 1.5;

  text-align: left;
}

/* =========================
   ЭКРАН 4
========================= */

.screen4 {

  background:
    radial-gradient(
      circle at 50% 35%,
      #ffffff,
      #f4f1ec 70%
    );
}

.heart {

  margin-bottom: 20px;

  font-size: 65px;

  color: #aeb8c2;

  animation: heartbeat 2s infinite ease-in-out;
}

.screen4 h1 {

  font-size: clamp(55px, 15vw, 80px);

  margin-bottom: 20px;
}

.final {

  font-family: 'Cormorant Garamond', serif;

  font-size: 23px;

  line-height: 1.5;
}

.final i {

  color: #858b93;
}

.spark {

  margin-top: 30px;

  color: #aeb8c2;

  font-size: 20px;
}

/* =========================
   АНИМАЦИИ
========================= */

@keyframes appear {

  from {
    opacity: 0;
    transform: translateY(20px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }

}

@keyframes float {

  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-8px);
  }

}

@keyframes heartbeat {

  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.12);
  }

}

</style>
</head>

<body>

<div class="app">

  <!-- ПЕРЕКЛЮЧАТЕЛИ -->

  <input type="radio" name="screens" id="screen1" checked>

  <input type="radio" name="screens" id="screen2">

  <input type="radio" name="screens" id="screen3">

  <input type="radio" name="screens" id="screen4">

  <div class="screens">

    <!-- ======================
         ЭКРАН 1
    ======================= -->

    <section class="screen screen1">

      <div class="content">

        <div class="small">
          для тебя 🤍
        </div>

        <h1>
          У меня есть<br>
          к тебе одно<br>
          предложение…
        </h1>

        <p class="subtitle">
          и от него довольно сложно отказаться.
        </p>

        <label for="screen2" class="next">
          Открыть приглашение →
        </label>

      </div>

    </section>

    <!-- ======================
         ЭКРАН 2
    ======================= -->

    <section class="screen screen2">

      <div class="content">

        <div class="idea">
          ✦
        </div>

        <div class="small">
          кажется…
        </div>

        <h1>
          У меня<br>
          появилась<br>
          идея…
        </h1>

        <p>
          Не ресторан.<br>
          Не кино.<br>
          Не очередной обычный вечер.
        </p>

        <p class="subtitle">
          А кое-что немного проще.<br>
          И, надеюсь, намного уютнее.
        </p>

        <label for="screen3" class="next">
          Узнать, что я придумал →
        </label>

      </div>

    </section>

    <!-- ======================
         ЭКРАН 3
    ======================= -->

    <section class="screen screen3">

      <div class="content">

        <div class="nature">
          🌿
        </div>

        <div class="small">
          наше маленькое свидание
        </div>

        <h1>
          Мини-пикник<br>
          на природе
        </h1>

        <p class="subtitle">
          просто мы, природа<br>
          и немного времени друг для друга.
        </p>

        <div class="date">

          <div>

            <div class="date-number">
              10
            </div>

            <div class="date-month">
              АВГУСТА
            </div>

          </div>

          <div class="line"></div>

          <div class="location">

            🌿 &nbsp; природа<br>
            &nbsp;&nbsp;&nbsp;&nbsp;мини-пикник

          </div>

        </div>

        <p>
          Возьмём что-нибудь вкусное,<br>
          плед и хорошее настроение.
        </p>

        <label for="screen4" class="next">
          Мне нравится эта идея →
        </label>

      </div>

    </section>

    <!-- ======================
         ЭКРАН 4
    ======================= -->

    <section class="screen screen4">

      <div class="content">

        <div class="heart">
          ♡
        </div>

        <div class="small">
          тогда договорились
        </div>

        <h1>
          10.08
        </h1>

        <p class="final">
          Я просто хочу провести<br>
          этот день <i>с тобой.</i>
        </p>

        <div class="date">

          <div>

            <div class="date-number">
              10
            </div>

            <div class="date-month">
              АВГУСТА
            </div>

          </div>

          <div class="line"></div>

          <div class="location">

            🌿 &nbsp; природа<br>
            &nbsp;&nbsp;&nbsp;&nbsp;мини-пикник

          </div>

        </div>

        <p>
          Ну что… пойдёшь со мной? 🤍
        </p>

        <div class="spark">
          ✦
        </div>

      </div>

    </section>

  </div>

</div>

</body>
</html